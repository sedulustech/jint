    "is_naming_convention_consistent": {
      "warn": {
        "less_than": 0.75
      },
      "error": {
        "less_than": 0.65
      }
    },
    "is_greppable": {
      "warn": {
        "less_than": 0.75
      },
      "error": {
        "less_than": 0.6
      }
    },
    "is_filename_fitting": {
      "warn": {
        "greater_than": 0.55
      },
      "error": {
        "greater_than": 0.75
      }
    },
    "is_comment_narration": {
      "warn": {
        "greater_than": 0.6
