{
  // Emit only: the root tsconfig is the one typecheck. This config narrows that program to the
  // cli (src only, keeping the wasm shim) and emits packages/cli/dist, which the root bin "jint"
  // points at via "bun run build".
  "extends": "../../tsconfig.json",
  "files": ["../sdk/src/wasm-assets.d.ts"],
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "dist"]
}
