---
import Layout from "./Layout.astro";
import { docGroups, labelOf, type Doc } from "../lib/docs";
import HeaderTools from "../components/HeaderTools.astro";
import CopyCode from "../components/CopyCode.astro";
import MenuToggle from "../components/MenuToggle.astro";

interface Props {
  doc: Doc;
}

const { doc } = Astro.props;
const current = doc.id;
const groups = await docGroups();
// The sidebar's order as one ring: the last page's next is the first, the first page's previous the last.
const ring = groups.flatMap((group) => group.docs);
const at = ring.findIndex((entry) => entry.id === current);
const previous = ring.length > 1 ? ring[(at - 1 + ring.length) % ring.length] : undefined;
const next = ring.length > 1 ? ring[(at + 1) % ring.length] : undefined;
const name = doc.data.title;
const title = `${name} - jint docs`;
const description = doc.data.description;
const site = Astro.site ?? new URL("https://jint.sh");
const pageUrl = new URL(`/docs/${doc.id}/`, site).href;
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: name,
    description,
    url: pageUrl,
    inLanguage: "en",
    isPartOf: { "@type": "WebSite", name: "jint", url: site.href },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "jint", item: site.href },
      { "@type": "ListItem", position: 2, name: "docs", item: new URL("/docs/what-is-jint/", site).href },
      { "@type": "ListItem", position: 3, name: name, item: pageUrl },
    ],
  },
];
---

<Layout {title} {description} {jsonLd} type="article" markdown={`/docs/${doc.id}.md`}>
  <div class="page">
    <header>
      <a href="/" aria-label="jint"><img src="/logo.svg" alt="jint" width="64" height="46" /></a>
      <div class="header-end">
        <HeaderTools />
        <MenuToggle />
      </div>
    </header>
    <div class="body">
      <nav id="docs-nav" aria-label="docs">
        {
          groups.map((group) => (
            <section>
              <h2>{group.label}</h2>
              <ul>
                {group.docs.map((entry) => (
                  <li>
                    <a
                      href={`/docs/${entry.id}/`}
                      aria-current={entry.id === current ? "page" : undefined}
                    >
                      {labelOf(entry)}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </nav>
      <main>
        <slot />
        {
          previous && next && (
            <footer class="pager" aria-label="pages">
              <a href={`/docs/${previous.id}/`} rel="prev">
                <span>Previous</span>
                {labelOf(previous)}
              </a>
              <a href={`/docs/${next.id}/`} rel="next">
                <span>Next</span>
                {labelOf(next)}
              </a>
            </footer>
          )
        }
      </main>
      <CopyCode />
    </div>
  </div>
</Layout>

<style>
  .page {
    max-width: 72rem;
    margin-inline: auto;
    padding-block: var(--s3) var(--s6);
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--s3);
    border-bottom: 1px solid var(--rule);
  }

  .header-end {
    display: flex;
    align-items: center;
    gap: var(--s1);
  }

  header img {
    display: block;
    width: 4rem;
    height: auto;
  }

  /* The sidebar is part of the page, not pinned: it scrolls away with the document. */
  .body {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr);
    gap: var(--s6);
    padding-top: var(--s4);
  }

  nav {
    display: grid;
    gap: var(--s4);
    align-content: start;
  }

  nav h2 {
    margin: 0 0 var(--s2);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  nav ul {
    display: grid;
    gap: var(--s1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
  }

  nav a {
    display: block;
    text-decoration: none;
    color: var(--muted);
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--fg);
    outline: none;
  }

  nav a[aria-current="page"] {
    color: var(--fg);
    font-weight: 600;
  }

  main {
    min-width: 0;
    max-width: 48rem;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s2);
    margin-top: var(--s6);
    padding-top: var(--s3);
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 0.25rem;
    color: var(--fg);
    text-decoration: none;
  }

  .pager a:last-child {
    text-align: right;
  }

  .pager span {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pager a:hover,
  .pager a:focus-visible {
    text-decoration: underline;
    outline: none;
  }

  @media (max-width: 48rem) {
    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s4);
    }

    /* the header stays pinned flush to the top, so nothing scrolls above it and the menu button is always reachable */
    .page {
      padding-top: 0;
    }

    header {
      position: sticky;
      top: 0;
      z-index: 20;
      padding-block: var(--s2);
      background: var(--bg);
    }

    /* with scripts on, the menu button opens the sidebar as a panel over the page; without them it stays a plain list */
    nav[data-collapsible]:not([data-open]) {
      display: none;
    }

    nav[data-open] {
      position: fixed;
      inset: 0;
      z-index: 10;
      overflow-y: auto;
      padding: 6rem var(--s2) var(--s4);
      background: var(--bg);
    }
  }
</style>

<style is:global>
  main :is(h1, h2, h3) {
    line-height: 1.3;
    margin-block: var(--s4) var(--s2);
  }

  main :is(h1, h2, h3)::first-letter {
    text-transform: uppercase;
  }

  main h1 {
    margin-top: 0;
    font-size: 1.5rem;
  }

  main h2 {
    font-size: 1.15rem;
  }

  main h3 {
    font-size: 1rem;
  }

  main p,
  main ul,
  main ol {
    margin-block: 0 var(--s2);
  }

  main pre {
    overflow-x: auto;
    margin-block: 0 var(--s2);
    padding: var(--s2);
    border: 1px solid var(--rule);
    background: var(--code-bg);
    font-size: var(--code-size);
    line-height: 1.6;
  }

  main code {
    font-size: 0.85em;
  }

  /* a block's or a table's own code is the block's size, not a smaller one inside it */
  main pre code,
  main table code {
    font-size: inherit;
  }

  /* inline code takes the code block's background; a block's own <code> stays flat */
  main :not(pre) > code {
    padding: 0.1em 0.35em;
    background: var(--code-bg);
  }

  main table {
    display: block;
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    margin-block: 0 var(--s2);
    border-collapse: collapse;
    background: var(--code-bg);
    font-size: var(--code-size);
  }

  main th,
  main td {
    border: 1px solid var(--rule);
    padding: var(--s1) var(--s2);
    text-align: left;
  }

  /* Dual-theme highlighting: each token carries both colors, the color scheme picks one. */
  .astro-code,
  .astro-code span {
    color: light-dark(var(--shiki-light), var(--shiki-dark));
  }
</style>
