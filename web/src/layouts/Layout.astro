---
interface Props {
  title?: string;
  description?: string;
  /** social-card image path; defaults to the sitewide card */
  image?: string;
  /** og:type: "website" for pages, "article" for docs */
  type?: "website" | "article";
  /** keep the page out of search indexes (the 404 page) */
  noindex?: boolean;
  /** schema.org objects, rendered as one JSON-LD script */
  jsonLd?: object[];
  /** the raw-markdown twin of this page, advertised to agents */
  markdown?: string;
}

const {
  title = "jint",
  description = "Semantic lint: AI-classifier judgments as findings.",
  image = "/og.jpg",
  type = "website",
  noindex = false,
  jsonLd = [],
  markdown,
} = Astro.props;

const site = Astro.site ?? new URL("https://jint.sh");
const canonical = new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(image, site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#000000" />
    <meta name="robots" content={noindex ? "noindex" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    {markdown && <link rel="alternate" type="text/markdown" href={new URL(markdown, site).href} />}
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content="jint" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <title>{title}</title>
    <script is:inline>
      // Resolve the theme before first paint. localStorage 'theme' is 'light' | 'dark' | absent (system).
      (() => {
        try {
          const t = localStorage.getItem("theme");
          if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
        } catch {
          // blocked storage: follow the system
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/ibm-plex-mono/IBMPlexMono-Regular.woff2") format("woff2");
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/ibm-plex-mono/IBMPlexMono-Medium.woff2") format("woff2");
    font-weight: 500;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "IBM Plex Mono";
    src: url("/fonts/ibm-plex-mono/IBMPlexMono-SemiBold.woff2") format("woff2");
    font-weight: 600;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --bg: #000;
    --fg: #fff;
    --muted: #a3a3a3;
    --rule: #262626;
    --code-bg: #0d0d0d;
    --font-body: "IBM Plex Mono", ui-monospace, monospace;
    /* spacing: one 8px grid, every gap and pad is a multiple */
    --s1: 0.5rem;
    --s2: 1rem;
    --s3: 1.5rem;
    --s4: 2rem;
    --s6: 3rem;
    color-scheme: dark;
  }

  :root[data-theme="light"] {
    --bg: #f1f0ea;
    --fg: #000;
    --muted: #5c5c57;
    --rule: #d6d4ca;
    --code-bg: #e8e6dc;
    color-scheme: light;
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) {
      --bg: #f1f0ea;
      --fg: #000;
      --muted: #5c5c57;
      --rule: #d6d4ca;
      --code-bg: #e8e6dc;
      color-scheme: light;
    }
  }

  * {
    box-sizing: border-box;
  }

  /* selection is the page's own two colors, not the browser's blue */
  ::selection {
    background: var(--fg);
    color: var(--bg);
  }

  html {
    /* reserve the scrollbar's width on every page: a short doc must not shift the layout */
    scrollbar-gutter: stable;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.5;
  }

  body {
    margin: 0;
    min-height: 100dvh;
    background: var(--bg);
    padding-inline: max(16px, env(safe-area-inset-left, 0px))
      max(16px, env(safe-area-inset-right, 0px));
  }

  a {
    color: inherit;
    text-underline-offset: 0.2em;
  }
</style>
