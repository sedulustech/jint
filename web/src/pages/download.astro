---
import DocsLayout from "../layouts/DocsLayout.astro";
import PrimaryButton from "../components/PrimaryButton.astro";

// The binaries mirror (functions/dl) serves the beta channel under /dl/download/beta/.
const PLATFORMS = [
  { label: "Linux x64", file: "jint-linux-x64.tar.gz" },
  { label: "Linux arm64", file: "jint-linux-arm64.tar.gz" },
  { label: "macOS Apple silicon", file: "jint-darwin-arm64.tar.gz" },
  { label: "macOS Intel", file: "jint-darwin-x64.tar.gz" },
  { label: "Checksums", file: "checksums.txt" },
  { label: "Commit", file: "COMMIT" },
];
// the beta channel: /dl/download/beta/<file> redirects to the one current build
const BETA = "/dl/download/beta";
---

<DocsLayout
  noindex
  title="Download jint - binaries for Linux and macOS"
  description="Download jint for Linux x64, Linux arm64, macOS Apple silicon or macOS Intel, with checksums."
>
  <h1>Download</h1>
  <p>Download the beta version.</p>
  <p class="notice" role="note">
    The macOS binaries are signed but not notarized. macOS blocks a binary downloaded in a browser
    the first time it runs. To allow it, open System Settings → Privacy &amp; Security and click
    Open Anyway, or run <code>xattr -d com.apple.quarantine jint</code>. The
    <a href="/docs/install/">install script</a> is not affected.
  </p>
  <ul class="platforms">
    {
      PLATFORMS.map(({ label, file }) => (
        <li>
          <PrimaryButton href={`${BETA}/${file}`}>
            <span class="row">
              <span>{label}</span>
              <span class="file">{file}</span>
            </span>
          </PrimaryButton>
        </li>
      ))
    }
  </ul>
  <p><a href="/docs/install/">install docs</a></p>
</DocsLayout>

<style>
  .platforms {
    display: grid;
    gap: var(--s1);
    margin: 0 0 var(--s3);
    padding: 0;
    list-style: none;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s1);
    width: 100%;
  }

  .notice {
    margin: 0 0 var(--s2);
    padding: var(--s1) var(--s2);
    border: 1px solid var(--sev-warn);
    background: color-mix(in srgb, var(--sev-warn) 12%, transparent);
  }

  .file {
    color: var(--muted);
  }
</style>
