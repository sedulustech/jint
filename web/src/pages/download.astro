---
import Layout from "../layouts/Layout.astro";
import HeaderTools from "../components/HeaderTools.astro";
import PrimaryButton from "../components/PrimaryButton.astro";

// The binaries mirror (functions/dl) serves the beta channel under /dl/download/beta/.
const PLATFORMS = [
  { label: "Linux x64", file: "jint-linux-x64.tar.gz" },
  { label: "Linux arm64", file: "jint-linux-arm64.tar.gz" },
  { label: "macOS Apple silicon", file: "jint-darwin-arm64.tar.gz" },
  { label: "macOS Intel", file: "jint-darwin-x64.tar.gz" },
];
// the unversioned beta channel, overwritten on every push to the beta branch
const BETA = "/dl/download/beta";
---

<Layout
  noindex
  title="Download jint - binaries for Linux and macOS"
  description="Download the jint binary for Linux x64, Linux arm64, macOS Apple silicon or macOS Intel, with checksums. It needs no JavaScript runtime."
>
  <div class="page">
    <header>
      <a href="/" aria-label="jint"><img src="/logo.svg" alt="jint" width="64" height="46" /></a>
      <HeaderTools />
    </header>
    <main>
      <h1>download</h1>
      <p>
        An unversioned build of the beta branch, overwritten on every push: <a href={`${BETA}/checksums.txt`}>checksums</a> ·
        <a href={`${BETA}/COMMIT`}>commit</a>
      </p>
      <ul class="platforms">
        {
          PLATFORMS.map(({ label, file }) => (
            <li>
              <PrimaryButton href={`${BETA}/${file}`}>
                <span class="row">
                  <span>{label}</span>
                  <span class="file">{file}</span>
                </span>
              </PrimaryButton>
            </li>
          ))
        }
      </ul>
      <p><a href="/docs/install/">install docs</a></p>
    </main>
  </div>
</Layout>

<style>
  .page {
    max-width: 40rem;
    margin-inline: auto;
    padding-block: var(--s3) var(--s6);
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--s3);
    border-bottom: 1px solid var(--rule);
  }

  header img {
    display: block;
    width: 4rem;
    height: auto;
  }

  main {
    padding-top: var(--s4);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  h1 {
    margin: 0 0 var(--s3);
    font-size: 1.5rem;
    line-height: 1.3;
  }

  h1::first-letter {
    text-transform: uppercase;
  }

  p {
    margin-block: 0 var(--s2);
  }

  .platforms {
    display: grid;
    gap: var(--s1);
    margin: 0 0 var(--s3);
    padding: 0;
    list-style: none;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s1);
    width: 100%;
  }

  .file {
    color: var(--muted);
  }

  pre {
    overflow-x: auto;
    margin: 0 0 var(--s2);
    padding: var(--s2);
    border: 1px solid var(--rule);
    background: var(--code-bg);
    font-size: 0.8rem;
  }
</style>
