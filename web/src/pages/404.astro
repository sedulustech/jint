---
import Layout from "../layouts/Layout.astro";
import Splash from "../components/Splash.astro";
import PrimaryButton from "../components/PrimaryButton.astro";
---

<Layout title="not found - jint" noindex>
  <Splash>
    <p slot="above">404</p>
    <Fragment slot="links">
      <PrimaryButton href="/">Home</PrimaryButton>
      <PrimaryButton href="/docs/install/">Docs</PrimaryButton>
    </Fragment>
  </Splash>
</Layout>

<style>
  p {
    margin: 0;
    color: var(--muted);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    text-align: center;
  }
</style>
