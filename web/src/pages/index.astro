---
import Layout from "../layouts/Layout.astro";
import Splash from "../components/Splash.astro";
import PrimaryButton from "../components/PrimaryButton.astro";

const DOWNLOAD = "/download/";
---

<Layout
  title="jint - extensible semantic linter"
  description="Write linting rules in plain English."
  jsonLd={[
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      name: "jint",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Linux, macOS",
      url: "https://jint.sh/",
      downloadUrl: "https://jint.sh/download/",
      description: "Write linting rules in plain English.",
    },
  ]}
>
  <Splash>
    <h1 class="visually-hidden">jint</h1>
    <Fragment slot="links">
      <PrimaryButton href={DOWNLOAD}>Download</PrimaryButton>
      <PrimaryButton href="/docs/what-is-jint/">Docs</PrimaryButton>
    </Fragment>
  </Splash>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
