---
/**
 * The centered page: the logo, an optional line over or under it, the links, and the company in the
 * bottom-right corner. The landing page and the 404 share it so they stay identical; pass the links
 * in the "links" slot.
 */
import HeaderTools from "./HeaderTools.astro";
import Logo from "./Logo.astro";
import CompanyFooter from "./CompanyFooter.astro";
---

<div class="corner"><HeaderTools /></div>
<main>
  <slot name="above" />
  <Logo class="logo" width={240} height={174} />
  <slot />
  <nav aria-label="jint">
    <slot name="links" />
  </nav>
</main>
<CompanyFooter placement="corner" />

<style>
  .corner {
    position: fixed;
    top: max(var(--s2), env(safe-area-inset-top, 0px));
    right: max(var(--s2), env(safe-area-inset-right, 0px));
  }
  main {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 2.25rem;
  }
  .logo {
    display: block;
    width: min(240px, 70vw);
    height: auto;
  }
  nav {
    display: flex;
    justify-content: space-between;
    width: min(240px, 70vw);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }
</style>
