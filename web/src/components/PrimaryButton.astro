---
/**
 * The primary button: the call to action a page leads with, and the docs pager's previous and next.
 * Its side rules draw from the middle out on hover and focus. With an href it is a link; without
 * one it is a button for a page script to act on. Reuse it where one action is prominent; a page
 * has no use for it when nothing on it is the main action. Any other attribute (rel, aria-label,
 * data-*) passes through to the element.
 */
import type { HTMLAttributes } from "astro/types";

type Props = { href?: string } & HTMLAttributes<"a"> & HTMLAttributes<"button">;
const { href, ...rest } = Astro.props;
---

{
  href === undefined ? (
    <button class="primary" type="button" {...rest}>
      <slot />
    </button>
  ) : (
    <a class="primary" href={href} {...rest}>
      <slot />
    </a>
  )
}

<style>
  .primary {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 2.75rem; /* a touch target on a phone */
    padding-inline: var(--s2);
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .primary:focus-visible {
    outline: none;
  }
  .primary::before,
  .primary::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--fg);
    transform: scaleY(0);
    transition: transform 0.25s ease;
  }
  .primary::before {
    left: 0;
  }
  .primary::after {
    right: 0;
  }
  .primary:hover::before,
  .primary:hover::after,
  .primary:focus-visible::before,
  .primary:focus-visible::after {
    transform: scaleY(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .primary,
    .primary::before,
    .primary::after {
      transition: none;
    }
  }
</style>
