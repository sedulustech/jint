---
// The docs' install-prompt line, docs/install.md: two plain links to /install-prompt.txt, so the
// line works on GitHub and in `jint docs`. On the site the script makes the #copy link copy the
// prompt, as the header's install-prompt button does, and opens the other link in a new tab.
---

<script>
  import { DONE_ICON, copyOnClick, icon, promptIcon } from "../lib/copy";
  import { INSTALL_PROMPT } from "../lib/install-prompt";

  const PROMPT_PATH = "/install-prompt.txt";
  for (const link of document.querySelectorAll<HTMLAnchorElement>("main a")) {
    if (link.pathname !== PROMPT_PATH) continue;
    if (link.hash !== "#copy") {
      link.target = "_blank";
      link.rel = "noopener";
      continue;
    }
    const label = link.textContent ?? "";
    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-prompt";
    const text = document.createElement("span");
    text.textContent = label;
    button.append(promptIcon(), text);
    link.replaceWith(button);
    copyOnClick(
      button,
      () => INSTALL_PROMPT,
      (copied) => {
        button.replaceChildren(copied ? icon(DONE_ICON) : promptIcon(), text);
        text.textContent = copied ? "Copied" : label;
      },
      // no clipboard access: show the prompt in a dialog, selected, for the reader to copy by hand
      () => window.prompt("Copy the install prompt", INSTALL_PROMPT),
    );
  }
</script>

<style is:global>
  .copy-prompt {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .copy-prompt svg {
    display: inline-block;
    width: 1.1em;
    height: 1.1em;
    margin-inline-end: 0.4em;
    vertical-align: -0.2em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
