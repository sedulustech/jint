---
// A copy button on every code block in the page's main content. The script wraps each <pre> and
// adds the button; the blocks are plain markdown output, so nothing in the docs changes.
---

<script>
  const COPY =
    "M15.666 3.888A2.25 2.25 0 0 0 13.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 0 1-.75.75H9a.75.75 0 0 1-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 0 1-2.25 2.25H6.75A2.25 2.25 0 0 1 4.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 0 1 1.927-.184";
  const DONE = "m4.5 12.75 6 6 9-13.5";

  const icon = (path: string) => {
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("aria-hidden", "true");
    const d = document.createElementNS("http://www.w3.org/2000/svg", "path");
    d.setAttribute("d", path);
    svg.append(d);
    return svg;
  };

  for (const pre of document.querySelectorAll<HTMLPreElement>("main pre")) {
    const wrap = document.createElement("div");
    wrap.className = "code-block";
    pre.replaceWith(wrap);
    wrap.append(pre);

    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-code";
    button.setAttribute("aria-label", "Copy code");
    button.append(icon(COPY));
    wrap.append(button);

    let reset: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? "");
      } catch {
        // no clipboard access (older app views, insecure origin): select the text so Ctrl+C works
        getSelection()?.selectAllChildren(pre);
        return;
      }
      button.setAttribute("aria-label", "Copied");
      button.replaceChildren(icon(DONE));
      clearTimeout(reset);
      reset = setTimeout(() => {
        button.setAttribute("aria-label", "Copy code");
        button.replaceChildren(icon(COPY));
      }, 1500);
    });
  }
</script>

<style is:global>
  .code-block {
    position: relative;
    margin-block: 0 var(--s2);
  }
  .code-block pre {
    margin: 0;
    padding-right: 3rem; /* room for the button over a long first line */
  }
  .copy-code {
    position: absolute;
    top: var(--s1);
    right: var(--s1);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: var(--code-bg);
    color: var(--fg);
    opacity: 0.6;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .copy-code:hover,
  .copy-code:focus-visible {
    opacity: 1;
  }
  .copy-code svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
