---
// A copy button on every code block in the page's main content. The script wraps each <pre> and
// adds the button; the blocks are plain markdown output, so nothing in the docs changes.
---

<script>
  import { COPY_ICON, DONE_ICON, copyOnClick, icon } from "../lib/copy";

  for (const pre of document.querySelectorAll<HTMLPreElement>("main pre")) {
    const wrap = document.createElement("div");
    wrap.className = "code-block";
    pre.replaceWith(wrap);
    wrap.append(pre);

    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-code";
    button.setAttribute("aria-label", "Copy code");
    button.append(icon(COPY_ICON));
    wrap.append(button);

    copyOnClick(
      button,
      () => pre.textContent ?? "",
      (copied) => {
        button.setAttribute("aria-label", copied ? "Copied" : "Copy code");
        button.replaceChildren(icon(copied ? DONE_ICON : COPY_ICON));
      },
      // select the text so Ctrl+C works
      () => getSelection()?.selectAllChildren(pre),
    );
  }
</script>

<style is:global>
  .code-block {
    position: relative;
    margin-block: 0 var(--s2);
  }
  .code-block pre {
    margin: 0;
    padding-right: 3rem; /* room for the button over a long first line */
  }
  .copy-code {
    position: absolute;
    top: var(--s1);
    right: var(--s1);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    background: var(--code-bg);
    color: var(--fg);
    opacity: 0.6;
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .copy-code:hover,
  .copy-code:focus-visible {
    opacity: 1;
  }
  .copy-code svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
