---
import data from "../data/reference.json";
import type { RefEntry, RefPages } from "../../../scripts/generate-schema";
import ReferenceEntry from "./ReferenceEntry.astro";
import { inline } from "../lib/inline";

// A reference page: its sections and their entries, from the data `bun run schema:generate` writes.
interface Props {
  page: keyof RefPages;
}
const { page } = Astro.props;
const sections = (data as unknown as RefPages)[page];
---

{
  sections.map((section) => (
    <section>
      <h2 id={section.title.toLowerCase().replaceAll(" ", "-")}>{section.title}</h2>
      {section.intro !== undefined && (
        <p>
          {inline(section.intro).map((part) => (part.kind === "code" ? <code>{part.text}</code> : part.text))}
        </p>
      )}
      {section.table !== undefined && (
        <table>
          <thead>
            <tr>
              {section.table.columns.map((column) => (
                <th>{column}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {section.table.rows.map(([value, meaning]) => (
              <tr>
                <td>
                  <code>{value}</code>
                </td>
                <td>{meaning}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
      {section.entries.map((entry: RefEntry) => (
        <ReferenceEntry {entry} />
      ))}
    </section>
  ))
}
