@@ -157,7 +157,8 @@ export class HelpOverlay {
     }
     dismiss(): void {
       if (!this.overlay) return;
-    this.overlay.destroy();
+    const overlay = this.overlay;
       this.overlay = null;
+    unmountOverlay(overlay);
     }
   }
 
