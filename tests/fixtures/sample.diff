diff --git a/src/tui/components/overlays/box.ts b/src/tui/components/overlays/box.ts
index 8a4c9d2..3e7f1b9 100644
--- a/src/tui/components/overlays/box.ts
+++ b/src/tui/components/overlays/box.ts
@@ -79,3 +79,18 @@ export function mountOverlay(
     applyThemeToAll(box, theme, detectedBg);
     renderer.root.add(box);
   }
+
+/**
+ * Tear down an overlay box. Callers null their references FIRST so a throwing destroy can never
+ * leave an overlay half-alive (open=true, un-dismissable); this wrapper keeps the throw itself from
+ * escaping into the keypress dispatch — a failed destroy must not wedge input.
+ */
+export function unmountOverlay(overlay: BoxRenderable): void {
+  try {
+    overlay.destroy();
+  } catch (err) {
+    log.debug("overlay_destroy_failed", { error: err instanceof Error ? err.message : String(err) });
+  }
+}
 
diff --git a/src/tui/components/overlays/help.ts b/src/tui/components/overlays/help.ts
