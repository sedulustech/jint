#!/bin/sh
set -e
bun run validate
# Informational agent-format render; never blocks (stderr hidden).
bunx --bun oxlint --format=agent src/ tests/ 2>/dev/null || true

# jint over the changes in this commit (see .githooks/jint-diff.ts). It needs a key and is skipped
# without one. It blocks on error-tier findings in changed code and on a broken run.
if [ -n "${JINT_API_KEY:-}${OPENAI_API_KEY:-}" ]; then
  bun .githooks/jint-diff.ts
fi
