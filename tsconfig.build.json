{
  // Emit config for the shipped dist/ tree (bun run build).
  //
  // tsc emit (not bun build --compile) is chosen because package.json already
  // publishes main/types from ./dist and files: ["dist", "src"] — a per-module
  // JS tree with .d.ts is exactly what that manifest promises. The runtime stays
  // bun either way: the CLI uses Bun.stdin/Bun.file/Bun.spawn, so dist must be
  // run with bun (see bin/jint -> dist/cli.js), not node.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    // rewrite the ./x.ts relative imports to ./x.js in the emitted JS
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false
  },
  "include": ["src"],
  "exclude": ["tmp", "probes", "node_modules", "dist", "tests", "scripts", "src/**/*.test.ts"]
}
