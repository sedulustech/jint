{
  "name": "jint",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "jint": "./packages/cli/dist/cli.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "jint.schema.json"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test --parallel",
    "schema": "bun scripts/generate-schema.ts",
    "build": "bun run schema && tsc -p packages/cli && chmod +x packages/cli/dist/cli.js",
    "typecheck": "tsc --noEmit && tsc -p packages/sdk --noEmit && tsc -p packages/cli --noEmit",
    "validate": "bun run schema && bun run typecheck && bun run lint && bun run build",
    "lint": "bunx --bun oxlint --type-aware && oxfmt --check",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build:compile": "bun run scripts/build.ts",
    "ui": "bun run --cwd packages/app build && bun run --cwd packages/app serve",
    "ui:dev": "bun run --cwd packages/app dev"
  },
  "dependencies": {
    "@jint/defaults": "workspace:*"
  },
  "devDependencies": {
    "@jint/sdk": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@types/bun": "^1.4.2",
    "bun-types": "^1.4.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "^7.0.2"
  }
}
