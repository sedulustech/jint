{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./packages/app/src/*"] },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "files": [
    "packages/sdk/src/wasm-assets.d.ts",
    // virtual-module ambient declarations + the config they type (jint.config.ts imports
    // jint:sdk / jint:rules/* - the config is part of the repo's checked surface)
    "packages/sdk/src/sdk.d.ts",
    "packages/rules/src/rules.d.ts",
    "jint.config.ts"
  ],
  // the one program: every package's source, typechecked together (cli emits through its own
  // config, which extends this one)
  "include": ["packages/*/src", "packages/app/server.ts", "packages/app/vite.config.ts"],
  "exclude": ["tmp", "probes", "node_modules", "dist", "packages/*/dist"]
}
